---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

export interface SlotProps {
  image?: ImageMetadata;
  quantity?: number;
  completedImage?: ImageMetadata;
  completed?: boolean;
}

interface Props extends SlotProps {}

const { image, quantity, completedImage, completed } = Astro.props as Props;
---

<div class="slot slot-border">
  {
    image && (
      <Image src={image} alt="Item" class="w-full h-full object-contain rendering-pixelated" />
    )
  }

  {
    completedImage && completed && (
      <Image
        src={completedImage}
        alt="Completed Image"
        class="w-full h-full object-contain rendering-pixelated absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-10 bg-black/50"
      />
    )
  }

  {quantity && quantity >= 1 && <span class="slot-quantity">{quantity}</span>}
</div>

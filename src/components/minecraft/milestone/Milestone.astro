---
import Container from "../Container.astro";
import MilestoneSlot from "./MilestoneSlot.astro";
---

<Container>
  <div class="flex flex-col">
    <p class="container-text">Milestone</p>

    <div class="flex flex-row md:flex-col gap-x-3 gap-y-1">
      <MilestoneSlot milestone="1 Parcial" />
      <MilestoneSlot milestone="2 Parcial" />
      <MilestoneSlot milestone="3 Parcial" />
      <MilestoneSlot milestone="Finals" />
    </div>
  </div>
</Container>

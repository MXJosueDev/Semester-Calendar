---
import Slot, { type SlotProps } from '@/components/minecraft/Slot.astro';

interface Props extends SlotProps {
  milestone: string;
}

const { image, milestone, completedImage, completed } = Astro.props as Props;
---

<div class="flex flex-1 flex-col items-center justify-center gap-0.5 min-w-0">
  <Slot
    image={image}
    completedImage={completedImage}
    completed={completed}
  />

  <p class="milestone-text">{milestone}</p>
</div>
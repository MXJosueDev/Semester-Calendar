---
import Layout from "@/layouts/Layout.astro";
import Title from "@/components/landing/Title.astro";
import Inventory from "@/components/minecraft/inventory/Inventory.astro";
import Milestone from "@/components/minecraft/milestone/Milestone.astro";
---

<Layout>
  <div class="flex flex-col items-center">
    <Title />

    <div
      class="flex flex-col md:flex-row items-center justify-center h-full gap-y-3 gap-x-5 mt-6 mx-1.5 max-w-4xl"
    >
      <Milestone />

      <Inventory />
    </div>
  </div>
</Layout>

<!-- Reloads page if needed -->
<script>
  import { getElapsedWeeks } from "@/utils/calendar.ts";

  let previousElapsedWeeks = getElapsedWeeks();

  setInterval(() => {
    if (previousElapsedWeeks !== getElapsedWeeks()) {
      location.reload();
    }
  }, 1000 * 1);
</script>

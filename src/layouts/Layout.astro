---
import Background from "@/components/shared/Background.astro";
import Footer from "@/components/shared/Footer.astro";
import "@/styles/global.css";
---

<!doctype html>
<html lang="en" class="overflow-x-hidden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Semester Calendar</title>
  </head>
  <body class="flex flex-col items-center min-h-dvh overflow-x-hidden py-3">
    <Background />

    <div class="flex flex-col flex-1">
      <slot />
    </div>

    <Footer />

    <script is:inline>
      const setPageVisibility = () => {
        document.body.dataset.pageVisible = String(document.visibilityState === "visible");
      };

      setPageVisibility();
      document.addEventListener("visibilitychange", setPageVisibility);
    </script>
  </body>
</html>
